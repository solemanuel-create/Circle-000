      <!-- O opencv_world traz o cap_dshow.obj, uma segunda copia da classe
           videoInput. Depois do %(AdditionalDependencies) para que o
           videoInput.lib do openFrameworks ganhe: se a copia do OpenCV
           responder as chamadas do ofVideoGrabber, ela escreve fora do
           objeto dele (layouts diferentes) e o app morre ao acaso.
           Kinect10.lib e so o import lib do Kinect10.dll do System32; nao
           briga com ninguem, mas o runtime exige o SDK instalado. -->
      <AdditionalDependencies>%(AdditionalDependencies);opencv_world4110.lib;opencv_img_hash4110.lib;libprotobuf.lib;ittnotify.lib;Kinect10.lib</AdditionalDependencies>
    </Link>
